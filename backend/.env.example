NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Owner-only gate. Protected pages and APIs fail closed unless the signed-in
# Supabase user ID exactly matches this server-only value.
QUOARAAI_OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# Zero-dollar provider policy. QuoaraAi only uses Cloudflare Workers AI when you
# have personally confirmed the account remains on Workers Free. The app has
# no paid/provider fallback in this mode and stops when free allocation is gone.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-workers-ai-api-token
QUOARAAI_CLOUDFLARE_FREE_ONLY=true
QUOARAAI_CLOUDFLARE_FREE_PLAN_CONFIRMED=false

# Chat: default free pool. Models may fail over only inside this comma-separated
# list. Current defaults in code are Meta Llama 4 Scout, Gemma 4 26B, then
# GPT-OSS 20B. Keep Workers Free confirmed before activating.
QUOARAAI_CHAT_ENABLED=false
QUOARAAI_CHAT_COST_MODE=free_only
QUOARAAI_CHAT_PROVIDER=cloudflare_free
QUOARAAI_CHAT_MAX_OUTPUT_TOKENS=2048
# CLOUDFLARE_CHAT_MODELS=@cf/meta/llama-4-scout-17b-16e-instruct,@cf/google/gemma-4-26b-a4b-it,@cf/openai/gpt-oss-20b

# Optional Gemini adapter remains installed but is NOT part of automatic free
# failover because code cannot prove whether a Google API key is attached to a
# billed project. Use only after a separate owner decision.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Research: Tavily Free currently provides 1,000 API credits/month with no
# credit card required and stops when credits are exhausted.
TAVILY_API_KEY=your-tavily-api-key
QUOARAAI_RESEARCH_ENABLED=false
QUOARAAI_RESEARCH_COST_MODE=free_only

# Image creation: Cloudflare Workers AI free allocation only. Auto mode routes
# between Flux Schnell and Leonardo Phoenix. Any provider failure/quota
# exhaustion stops the request; there is no paid fallback.
QUOARAAI_IMAGE_GENERATION_ENABLED=false
QUOARAAI_IMAGE_COST_MODE=free_only
QUOARAAI_IMAGE_PROVIDER=cloudflare_free

# Video provider abstraction exists but remains disabled until a provider is
# selected and the owner approves its cost/security policy.
QUOARAAI_VIDEO_ENABLED=false
QUOARAAI_VIDEO_COST_MODE=free_only

# After applying owner_device_security migration, set true to require Android Keystore signatures for approvals.
QUOARAAI_DEVICE_SIGNED_APPROVALS_REQUIRED=false
